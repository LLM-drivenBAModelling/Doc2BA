# Choose provider: openai | anthropic | azure
LLM_PROVIDER=openai

# Default model per provider
# For openai: e.g., gpt-4o-mini, gpt-4o, gpt-4.1-mini, gpt-5
# For anthropic: e.g., claude-3-5-sonnet-latest
# For azure: this is typically ignored; set AZURE_OPENAI_DEPLOYMENT instead
DEFAULT_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

